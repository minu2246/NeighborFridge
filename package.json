{
  "name": "neighbor-fridge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build --workspace @neighbor-fridge/api",
    "test": "npm run test --workspace @neighbor-fridge/api",
    "start:api": "npm run build --workspace @neighbor-fridge/api && node apps/api/dist/main.js",
    "start:mobile": "npm run start --workspace @neighbor-fridge/mobile",
    "start:web": "npm run web --workspace @neighbor-fridge/mobile",
    "phone:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-phone-preview.ps1 -CheckOnly",
    "phone:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-phone-preview.ps1",
    "phone:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-phone-preview.ps1",
    "e2e": "tsx scripts/e2e/01-basic-two-accounts.ts && tsx scripts/e2e/02-login-nickname.ts && tsx scripts/e2e/03-profile-stats.ts && tsx scripts/e2e/04-reviews-manner.ts && tsx scripts/e2e/05-weight-chat-praises.ts && tsx scripts/e2e/06-empty-chat-room.ts && tsx scripts/e2e/07-ocr-synthetic.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
